rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function role(uid) { return profile(uid).data.role == 'administrador' || profile(uid).data.role == 'admin' ? 'administrador' : profile(uid).data.role == 'empleado' || profile(uid).data.role == 'employee' ? 'empleado' : 'cliente'; }
    function isAdmin() { return signedIn() && role(request.auth.uid) == 'administrador'; }
    function isEmployee() { return signedIn() && role(request.auth.uid) == 'empleado'; }
    function validAppointmentState(state) { return state in ['hold', 'pendiente_de_aprobacion', 'confirmada', 'en_curso', 'completada', 'cancelada', 'rechazada', 'expirada']; }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.role in ['cliente', 'customer'];
      allow update: if isAdmin() || (signedIn() && uid == request.auth.uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /clientes/{clienteId} {
      allow read: if signedIn() && (clienteId == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && clienteId == request.auth.uid;
      allow delete: if signedIn() && (clienteId == request.auth.uid || isAdmin());
    }

    match /servicios/{servicioId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /empleados/{empleadoId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (isEmployee() && empleadoId == request.auth.uid);
    }

    match /citas/{citaId} {
      allow read: if signedIn() && (resource.data.clienteId == request.auth.uid || resource.data.empleadoId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /negocios/{negocioId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /{subcollection}/{documentId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /notificaciones/{notifId} {
      allow read: if signedIn() && resource.data.destinatarioId == request.auth.uid;
      allow update: if signedIn() && resource.data.destinatarioId == request.auth.uid;
      allow create, delete: if false;
    }
  }
}
